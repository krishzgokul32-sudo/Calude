# Copy this file to ".env" (same folder as docker-compose.yml) and fill it in.
# docker compose reads .env automatically. Never commit your real .env.

# AI brain (optional). GK works with ANY provider; each user can also add their own key in Settings.
# Claude key from https://console.anthropic.com (no quotes, no spaces):
ANTHROPIC_API_KEY=
# ...or any other provider's key. AI_PROVIDER: openai, gemini, groq, openrouter, mistral, deepseek,
# xai, together, ollama or custom (guessed from the key when blank). AI_MODEL blank = provider default.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Only for ollama / custom, e.g. http://host.docker.internal:11434/v1
AI_BASE_URL=

# Long random text that signs logins. Generate one with:  openssl rand -hex 32
JWT_SECRET=please-change-me

# The address people use to open GK (used for CORS, MCP connection URLs and Telegram webhooks).
# With https, Telegram uses webhooks instead of polling.
CLIENT_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080

# Limits (TRACEN guide §02/§14)
API_RATE_LIMIT=300        # API requests per minute per user
AI_DAILY_LIMIT=200        # Claude messages per user per day (0 = unlimited)
MONGO_POOL_SIZE=50        # DB connections per API copy; keep copies × this below your DB's limit

# Protects /api/health/metrics outside localhost. Generate with: openssl rand -hex 16
METRICS_TOKEN=

# Create the demo account (demo@assistant.dev / demo1234). Set to false on a real deployment.
SEED_DEMO=true
