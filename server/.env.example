PORT=5000
CLIENT_URL=http://localhost:5173
# Use a real MongoDB (local or Atlas)...
MONGO_URI=mongodb://127.0.0.1:27017/personal_assistant
# ...or set to true to boot an in-memory MongoDB (great for demos, data is lost on restart)
USE_MEMORY_DB=false
# Long random text (32+ characters). Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Optional: a server-wide AI key. Users can also add their own (any provider) in Settings.
# Claude:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# ...or any other provider: openai, gemini, groq, openrouter, mistral, deepseek, xai, together,
# ollama, custom. AI_PROVIDER is guessed from the key when blank; AI_MODEL blank = provider default.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Only for ollama / custom (or to override a provider's address), e.g. http://host.docker.internal:11434/v1
AI_BASE_URL=
# Optional: Python AI micro-service (sentiment, intent, summaries)
AI_SERVICE_URL=http://localhost:8000
# Public URL of this API, used for MCP connection URLs and Telegram webhooks (e.g. an ngrok URL)
PUBLIC_API_URL=http://localhost:5000

# --- Production settings (TRACEN guide) ---
# Number of proxies in front of the API (1 behind nginx / a load balancer) so client IPs are right.
TRUST_PROXY=
# Requests per minute per user on the API.
API_RATE_LIMIT=300
# Claude messages per user per day (0 = unlimited).
AI_DAILY_LIMIT=200
# MongoDB connections per API process.
MONGO_POOL_SIZE=50
# Token for /api/health/metrics outside localhost.
METRICS_TOKEN=
# json for structured logs (default in production); debug | info | warn | error
LOG_FORMAT=
LOG_LEVEL=
# Allow bot webhooks to private network addresses in production (default: blocked).
ALLOW_PRIVATE_WEBHOOKS=
