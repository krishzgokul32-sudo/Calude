PORT=5000
CLIENT_URL=http://localhost:5173
# Use a real MongoDB (local or Atlas)...
MONGO_URI=mongodb://127.0.0.1:27017/personal_assistant
# ...or set to true to boot an in-memory MongoDB (great for demos, data is lost on restart)
USE_MEMORY_DB=false
JWT_SECRET=change-me-to-a-long-random-string
# Optional: enables the Claude-powered brain + AI persona bots. Without it a rule-based brain is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Optional: Python AI micro-service (sentiment, intent, summaries)
AI_SERVICE_URL=http://localhost:8000
# Public URL of this API, used to register Telegram webhooks (e.g. an ngrok URL)
PUBLIC_API_URL=http://localhost:5000
